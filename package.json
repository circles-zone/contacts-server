{
  "name": "@circles-zone/contacts-server",
  "version": "0.0.1",
  "description": "Apollo GraphQL server for contacts system https://github.com/circles-zone/contacts-server/pkgs/npm/contacts-server",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "/dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/circles-zone"
  },
  "scripts": {
    "huskyInstall": "husky install",
    "prepare": "run-s tsc huskyInstall",
    "upgrade_packages": "npm update --save",
    "tsc": "tsc",
    "compile": "npx tsc",
    "build": "npm i && npx tsc",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "jest --config ./jest.config.js --forceExit --detectOpenHandles --coverage",
    "dev": "ts-node-dev src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@apollo/client": ">=4.0.11",
    "apollo-server": ">=3.12.0",
    "dotenv": ">=17.2.3",
    "graphql": ">=16.12.0",
    "graphql-tag": ">=2.12.6",
    "mysql2": ">=3.16.0",
    "@circles-zone/contacts-local": "file:../contacts-local-typescript-package"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.3",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": ">=8.50.0",
    "@typescript-eslint/parser": ">=8.50.0",
    "eslint": ">=9.39.2",
    "husky": ">=8.0.0",
    "jest": "^30.2.0",
    "nodemon": ">=3.0.0",
    "npm-run-all": ">=4.1.5",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
