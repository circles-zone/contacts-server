{
  "name": "@circles-zone/contacts-server",
  "version": "0.0.2",
  "description": "Apollo GraphQL server for contacts system https://github.com/circles-zone/contacts-server/pkgs/npm/contacts-server",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "/dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/circles-zone"
  },
  "scripts": {
    "huskyInstall": "husky install",
    "prepare": "run-s tsc huskyInstall",
    "upgrade_packages": "npm update --save",
    "tsc": "tsc",
    "compile": "npx tsc",
    "build": "npm i && npx tsc",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest --config ./jest.config.js --forceExit --detectOpenHandles --coverage",
    "dev": "ts-node-dev src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@apollo/client": ">=4.0.11",
    "@circles-zone/contacts-local-typescript-package": "file:../contacts-local-typescript-package",
    "apollo-server": "^3.13.0",
    "dotenv": ">=17.2.3",
    "graphql": ">=16.12.0",
    "graphql-tag": ">=2.12.6",
    "mysql2": ">=3.16.0"
  },
  "devDependencies": {
    "@babel/preset-env": "7.28.5",
    "@babel/preset-typescript": "7.28.5",
    "@types/node": "24.3.1",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "babel-jest": "30.2.0",
    "eslint": "^9.35.0",
    "husky": ">=8.0.0",
    "nodemon": ">=3.0.0",
    "npm-run-all": ">=4.1.5",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.42.0"
  },
  "type_todo": "TODO Please move from CommonJs to ES Module",
  "type": "commonjs"
}
