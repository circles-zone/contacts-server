{
  "name": "@circles-zone/contacts-server",
  "version": "0.0.2",
  "description": "Apollo GraphQL server for contacts system https://github.com/circles-zone/contacts-server/pkgs/npm/contacts-server",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "/dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/circles-zone"
  },
  "scripts": {
    "prepare": "cd .. && husky contacts-server/.husky",
    "upgrade_packages": "npm update --save",
    "tsc": "tsc",
    "compile": "npx tsc",
    "prebuild_comment": "TODO Should it be `prebuild` or `preinstall` https://stackoverflow.com/questions/41123631/how-to-get-the-version-from-the-package-json-in-typescript",
    "prebuild": "node -p \"'export const PACKAGE_VERSION = ' + JSON.stringify(require('./package.json').version) + ';'\" > ./contacts-server/src/version.ts",
    "prebuild_new": "node -e \"import fs from 'fs'; import {createRequire} from 'module'; const require = createRequire(import.meta.url); const pkg = require('./package.json'); fs.writeFileSync('language-remote/src/version.ts', 'export const PACKAGE_VERSION = ' + JSON.stringify(pkg.version) + ';');\"",
    "build": "npm i && npx tsc",
    "build_fast": "npm i && npx tsc",
    "build_full": "npm update && npx tsc",
    "lint": "eslint **/src/**/*.ts **/tests/**/*.ts --ignore-pattern **/dist/**/*.ts --no-warn-ignored --report-unused-disable-directives --max-warnings 0 --fix",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config ./jest.config.mjs --forceExit --detectOpenHandles --coverage",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --config ./jest.config.mjs --forceExit --detectOpenHandles --coverage --watchAll=false",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/e2e/jest-e2e.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@apollo/client": ">=4.0.11",
    "@circles-zone/contacts-local-typescript-package": "file:../../contacts-local-typescript-package/contacts-local-typescript-package",
    "apollo-server": "^3.13.0",
    "dotenv": ">=17.2.3",
    "graphql": ">=16.12.0",
    "graphql-tag": ">=2.12.6",
    "mysql2": ">=3.16.0"
  },
  "devDependencies": {
    "@babel/preset-env": "7.28.5",
    "@babel/preset-typescript": "7.28.5",
    "@types/jest": "^29.5.12",
    "@types/node": "24.3.1",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "8.57.1",
    "@typescript-eslint/parser": "8.57.1",
    "babel-jest": "30.2.0",
    "cross-env": "^7.0.3",
    "eslint": "9.39.4",
    "husky": "^9.1.4",
    "jest": "^29.7.0",
    "nodemon": ">=3.0.0",
    "npm-run-all": ">=4.1.5",
    "supertest": "^7.1.4",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.42.0"
  }
}
