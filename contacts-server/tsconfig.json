{
  "compilerOptions": {
    "moduleResolution": "NodeNext",    /* Specify how TypeScript looks up a file from a given module specifier. */
    "module": "NodeNext",              /* Specify what module code is generated. */
    "target": "ESNext",                /* Set the JavaScript language version for emitted JavaScript. */
    "sourceMap": true,                 // For debugging
    "rootDir": "./contacts-server/src", /* Specify the root folder within your source files. */
    "outDir": "./dist",                // For package exporting
    "declaration": true,
    "strict": true,                    // For typescript compiler settings
    "noImplicitReturns": true,
    "noUnusedParameters": true,
    "noImplicitAny": true,
    "noEmitOnError": true,
    "noUncheckedIndexedAccess": true,
    "typeRoots": ["./node_modules/@types/"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["**/src/**/*"],
  "exclude": ["node_modules", "tests", "dist"]
}
